{
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/blog", "destination": "https://peptide-emails-blog.vercel.app/blog" },
    { "source": "/blog/:path*", "destination": "https://peptide-emails-blog.vercel.app/blog/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
